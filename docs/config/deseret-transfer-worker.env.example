# Deseret host only; no AIGC storage Secret. / 仅 Deseret 主机，不含 AIGC 存储密钥。
DESERET_RELAY_PORT=5390
DESERET_RELAY_BUCKET=
DESERET_RELAY_ENDPOINT=https://s3.us-east-2.wasabisys.com
DESERET_RELAY_REGION=us-east-2
DESERET_RELAY_ACCESS_KEY_ID=
DESERET_RELAY_SECRET_ACCESS_KEY=
# JSON arrays; exact real prefixes, never an empty/all-bucket source.
# JSON 数组；按真实对象键填写，不允许空来源范围。
DESERET_RELAY_SOURCE_PREFIXES='["project-files/"]'
DESERET_RELAY_REVIEW_PREFIX=aigc-review/
DESERET_RELAY_AIGC_BUCKET=
DESERET_RELAY_AIGC_ENDPOINT=https://s3.ap-southeast-1.wasabisys.com
# Fill both explicitly, including the actual WASABI_PREFIX. These are not auto-prefixed.
# 必须填写两项完整实际前缀（包含 WASABI_PREFIX）；不会自动拼接。
# JSON array of <WASABI_PREFIX>clients/<AIGC client ID>/projects/ prefixes; exclude the shared staging directory.
# 填写相应客户的项目目录，以斜杠结尾；共享暂存区不应取得读取授权。
DESERET_RELAY_AIGC_READ_PREFIXES=
DESERET_RELAY_AIGC_WRITE_PREFIXES=
# Control HMAC shared only with the AIGC relay adapter. / AIGC 控制请求的独立 HMAC。
DESERET_RELAY_KEY_ID=
DESERET_RELAY_SECRET=
# Deseret verifies each source against its CURRENT approved frozen handoff.
# Deseret 每次按当前已批准冻结清单核验。配对本平台 RelayAuthKeyId/RelayAuthSecret。
# Dedicated read-only authorization HMAC, distinct from business Incoming/Outgoing and relay control secrets.
# 独立只读认证身份，不得复用业务 Incoming/Outgoing 或 relay 控制密钥。
DESERET_RELAY_AUTH_ORIGIN=https://testauthordb.lifewood.com
DESERET_RELAY_AUTH_KEY_ID=
DESERET_RELAY_AUTH_SECRET=
