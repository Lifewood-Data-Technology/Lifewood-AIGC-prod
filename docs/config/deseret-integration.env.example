# Merge these integration fields into the selected private deployment config.
# This example contains no storage credentials and is not loaded automatically.
LIFEWOOD_DESERET_INTEGRATION_ENABLED=false
LIFEWOOD_DESERET_INTEGRATION_PEER_BASE_URL=
LIFEWOOD_DESERET_INTEGRATION_ALLOW_LOOPBACK_HTTP=false
LIFEWOOD_DESERET_INTEGRATION_INCOMING_KEY_ID=
LIFEWOOD_DESERET_INTEGRATION_INCOMING_SECRET=
LIFEWOOD_DESERET_INTEGRATION_OUTGOING_KEY_ID=
LIFEWOOD_DESERET_INTEGRATION_OUTGOING_SECRET=
LIFEWOOD_DESERET_INTEGRATION_CLIENT_ID=
LIFEWOOD_DESERET_INTEGRATION_INTAKE_OWNER_EMAIL=
LIFEWOOD_DESERET_INTEGRATION_INTAKE_DUE_DAYS=

# Existing AIGC WASABI_* fields continue to supply AIGC's own credentials.
# The peer profile contains no Deseret credentials.
LIFEWOOD_DESERET_TRANSFER_STRATEGY=pending
LIFEWOOD_DESERET_TRANSFER_DESERET_PROFILE_ID=
LIFEWOOD_DESERET_TRANSFER_DESERET_BUCKET=
LIFEWOOD_DESERET_TRANSFER_DESERET_ENDPOINT=
LIFEWOOD_DESERET_TRANSFER_DESERET_REGION=
# Restricts full Deseret object keys to this namespace. It is never prepended.
LIFEWOOD_DESERET_TRANSFER_DESERET_PREFIX=
LIFEWOOD_DESERET_TRANSFER_DESERET_REVIEW_PREFIX=aigc-review/
LIFEWOOD_DESERET_TRANSFER_AIGC_PROFILE_ID=

# Independent Wasabi accounts and regions: select deseret_relay after testing the
# companion worker and publisher authorizer. See ../DESERET_CROSS_REGION.md.
# 跨账户、跨区传输请先验收中继和出版社授权接口，再启用 deseret_relay。
LIFEWOOD_DESERET_RELAY_ORIGIN=
LIFEWOOD_DESERET_RELAY_KEY_ID=
LIFEWOOD_DESERET_RELAY_SECRET=
LIFEWOOD_DESERET_RELAY_ALLOW_LOOPBACK_HTTP=false
