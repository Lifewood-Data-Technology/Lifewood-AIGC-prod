# Include inside the existing Deseret HTTPS server block.
# 放进现有 Deseret HTTPS server 块；不增加公网明文端口。
location = /internal/deseret-transfer {
    client_max_body_size 1m;
    proxy_pass http://127.0.0.1:5390;
    proxy_http_version 1.1;
    proxy_connect_timeout 5s;
    proxy_read_timeout 125s;
    proxy_send_timeout 125s;
    proxy_buffering off;
    proxy_request_buffering on;
}
